# Copy this file to `.env` (in each service directory, or export as real
# environment variables) before running DevPilot. NEVER commit a real `.env`.

# ── LLM provider (OpenAI-compatible endpoint) ──────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── Auth (shared HS256 secret; generate with: openssl rand -base64 64) ──
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# ── Database (PostgreSQL + pgvector) ───────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/devpilot
DB_USERNAME=postgres
DB_PASSWORD=

# ── Service discovery ──────────────────────────────────────────
EUREKA_URL=http://localhost:8761/eureka/
EUREKA_INSTANCE_HOSTNAME=localhost

# ── Gateway ────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── AI agent workspace root (absolute path to the code it operates on) ──
DEVPILOT_WORKSPACE_ROOT=

# ── SQL logging (true/false) ───────────────────────────────────
SHOW_SQL=false
